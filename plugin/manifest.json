{
    "id": "com.bertelsmann.posterbatch",
    "name": "Poster Batch Generator",
    "version": "1.0.1",
    "main": "index.html",
    "manifestVersion": 5,
    "host": {
        "app": "ID",
        "minVersion": "18.0"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "posterBatchPanel",
            "label": {
                "default": "Poster Batch"
            },
            "minimumSize": { "width": 340, "height": 420 },
            "maximumSize": { "width": 900, "height": 1400 },
            "preferredDockedSize": { "width": 420, "height": 640 },
            "preferredFloatingSize": { "width": 420, "height": 640 }
        }
    ],
    "requiredPermissions": {
        "localFileSystem": "fullAccess",
        "launchProcess": {
            "schemes": ["file"],
            "extensions": [".jpg", ""]
        }
    }
}
